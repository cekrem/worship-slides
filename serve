#!/bin/sh

if command -v bunx >/dev/null 2>&1; then
  alias runner=bunx
elif command -v npx >/dev/null 2>&1; then
  alias runner=npx
else
  echo "Error: you need either $(bunx) or $(npx) in your PATH to run this!" >&2
  exit 1
fi

# Regenerate the deck when a song changes, so marp's live reload picks it up.
./create-deck
while sleep 1; do ./create-deck; done &
trap 'kill $!' EXIT INT TERM

runner @marp-team/marp-cli@latest ./ -s
