#!/bin/sh

# Builds index.md: a single master deck, one song per slide.
# lyrics/*.md stays the only source of truth for content.

deck=index.md
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT INT TERM

printf '%s\n' '---' 'paginate: false' '---' >"$tmp"
printf '%s\n\n' '# Sanger' >>"$tmp"

# Slide 1 is this index; the songs follow. Marp's HTML output navigates
# by URL fragment (#2, #3, ...), so these links jump within the deck.
page=1
for file in lyrics/*.md; do
  page=$((page + 1))
  title=$(sed -n 's/^# //p; /^# /q' "$file")
  [ -n "$title" ] || title=$(basename "$file" .md | sed 's/-/ /g')
  printf '[%s](#%s)\n' "$title" "$page" >>"$tmp"
done

for file in lyrics/*.md; do
  printf '\n---\n\n' >>"$tmp"
  cat "$file" >>"$tmp"
done

# Only touch index.md when it actually changed, so `serve`'s regeneration
# loop doesn't trigger an endless stream of live reloads.
cmp -s "$tmp" "$deck" || cp "$tmp" "$deck"
